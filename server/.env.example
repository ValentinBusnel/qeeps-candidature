PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/qeeps-candidature
CLIENT_ORIGIN=http://localhost:5173

# Compte admin créé au premier démarrage (si aucun compte n'existe encore).
# Sans ADMIN_PASSWORD, un lien 🔑 s'affiche dans les journaux du serveur pour le créer depuis le site.
# Ensuite, email et mot de passe se changent depuis /admin > Identifiants.
ADMIN_EMAIL=toi@exemple.com
ADMIN_PASSWORD=change-moi-avec-10-caracteres-min

# Envoi des invitations par email (facultatif : sinon l'admin affiche le lien à copier).
# Brevo (expéditeur = une adresse vérifiée, ex. Gmail) OU Resend (domaine vérifié).
BREVO_API_KEY=
RESEND_API_KEY=
MAIL_FROM=
MAIL_FROM_NAME=Valentin Busnel

# Secret de signature des sessions (64 caractères aléatoires) :
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=
